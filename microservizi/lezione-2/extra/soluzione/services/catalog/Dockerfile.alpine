# Esercizio 1: la stessa immagine su Alpine Linux, molto più piccola.
#   docker build -f services/catalog/Dockerfile.alpine -t shop-catalog:alpine ./services/catalog
#   docker images shop-catalog
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
# Dopo l'installazione svuotiamo la cache di npm nello STESSO RUN:
# in un RUN separato il layer con la cache resterebbe comunque nell'immagine.
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "dist/server.js"]
