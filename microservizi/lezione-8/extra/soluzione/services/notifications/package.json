{
  "name": "notifications",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servizio notifications: ascolta gli eventi del negozio e manda le email",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dlq:riprova": "tsx src/replay-cli.ts"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "fastify": "^5.12.5",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
